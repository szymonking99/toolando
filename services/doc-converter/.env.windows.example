# Skopiuj: copy .env.windows.example .env
# Ten sam CONVERTER_SECRET wpisz w Vercel jako DOC_CONVERTER_SECRET.

CONVERTER_SECRET=wpisz-losowy-sekret-minimum-32-znakow
PORT=8080
MAX_UPLOAD_MB=50
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Auto-sync Toolando z GitHub (POST /hooks/sync) — osobny sekret, nie ten od konwersji.
# Ten sam wpisz w GitHub Secrets jako CONVERTER_SYNC_SECRET (repo Toolando).
DEPLOY_SYNC_SECRET=wpisz-inny-losowy-sekret-min-32-znaki
TOOLANDO_ROOT=F:\Toolando
PM2_APP_NAME=toolando-converter

# Bot BadylTech MegaBot (FB / publikacja) — lokalny backup, NIE doc-converter.
# MEGABOT_ROOT / BOT_ROOT = F:\apps\badyltech-megabot
BOT_ROOT=F:\apps\badyltech-megabot
# BOT_BACKUP_ENABLED=0

# Kopie zapasowe Toolando (przy sync) + MegaBot (Task Scheduler osobno).
# SYNC_BACKUP_DIR=F:\backups
SYNC_BACKUP_KEEP=10
# SYNC_LOG_DIR=F:\logs
