# Skopiuj do .env.local i uzupełnij wartości (opcjonalne do podglądu strony).
# Strona główna i większość konwerterów działa bez bazy danych.
# Konto / premium wymaga PostgreSQL + Stripe.

# --- Aplikacja ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=wygeneruj-losowy-ciag-znakow-min-32-znaki

# --- Monetyzacja (AdSense lub Ezoic) ---
# Sieć reklamowa: adsense | ezoic | none
NEXT_PUBLIC_AD_NETWORK=adsense
# Ukryj reklamy podczas weryfikacji sieci (AdSense / Ezoic onboarding)
NEXT_PUBLIC_ADS_REVIEW_MODE=true
# Downloader wideo→MP3: domyślnie wyłączony przy AdSense (NEXT_PUBLIC_DOWNLOADER_ENABLED=true po akceptacji)
# Po akceptacji: ADS_REVIEW_MODE=false. Opcjonalnie wszystkie sloty:
# NEXT_PUBLIC_ADS_FULL=true

# --- Google AdSense (gdy NEXT_PUBLIC_AD_NETWORK=adsense) ---
# Publisher ID — meta google-adsense-account + ads.txt
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1137300798632743
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOLS=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
# Legacy aliasy (nadal działają):
# NEXT_PUBLIC_ADSENSE_REVIEW_MODE=true
# NEXT_PUBLIC_ADSENSE_FULL=true

# --- Ezoic (gdy NEXT_PUBLIC_AD_NETWORK=ezoic) ---
# ads.txt: auto-sync z https://srv.adstxtmanager.com/19390/toolando.tech (patrz app/ads.txt)
# EZOIC_ADSTXT_ACCOUNT_ID=19390
# EZOIC_ADSTXT_DOMAIN=toolando.tech
# Opcjonalnie numery placeholderów z panelu Ezoic (puste = Step 3 id-less showAds):
# NEXT_PUBLIC_EZOIC_PLACEMENT_HOME=
# Debug integracji JS: https://toolando.tech/pl?ez_js_debugger=1
# NEXT_PUBLIC_EZOIC_PLACEMENT_TOOLS=
# NEXT_PUBLIC_EZOIC_PLACEMENT_TOOL=
# NEXT_PUBLIC_EZOIC_PLACEMENT_FOOTER=

# --- Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HCDN6BEKZH

# --- Baza (opcjonalnie — logowanie, premium) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/toolando

# --- FFmpeg (opcjonalnie — domyślnie używa @ffmpeg-installer/ffmpeg) ---
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# --- LibreOffice (zalecane dla PDF ↔ DOCX — znacznie lepsza jakość layoutu) ---
# Lokalnie (Windows): wykryje C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_DISABLE=1  # wymuś stary silnik JS (mammoth/mupdf) bez LibreOffice

# --- Zdalny konwerter (produkcja na Vercel → Windows Server przez Cloudflare Tunnel) ---
# DOC_CONVERTER_URL=https://converter.toolando.tech
# DOC_CONVERTER_SECRET=ten-sam-co-CONVERTER_SECRET-na-serwerze
# DOC_CONVERTER_TIMEOUT_MS=120000
#
# Instrukcja Windows Server + auto-sync: docs/konwerter-windows-server-pl.md
# Instrukcja VPS/Docker: docs/konwerter-vps-pl.md

# --- RAR (lokalnie Windows — opcjonalnie, dla ZIP → RAR bez VPS) ---
# RAR_PATH=C:\Program Files\WinRAR\Rar.exe

# --- SEO / indeksowanie ---
# Klucz IndexNow (plik public/{KEY}.txt) — po deploy: node scripts/submit-indexnow.mjs
# INDEXNOW_KEY=toolando-indexnow-2026

# --- Stripe / e-mail / AI (opcjonalnie) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# RESEND_API_KEY=
# AI_GATEWAY_API_KEY=
