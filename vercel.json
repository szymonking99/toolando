{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "NEXT_PUBLIC_AD_NETWORK": "adsense",
      "NEXT_PUBLIC_ADS_REVIEW_MODE": "true"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-blobs",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/revalidate-adstxt",
      "schedule": "0 6 * * *"
    }
  ]
}
